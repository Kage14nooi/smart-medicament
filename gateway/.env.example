PORT=4000
NODE_ENV=development
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=smart_medicament

REDIS_URL=redis://localhost:6379

AGENT_MONITORING_URL=http://localhost:8001
AGENT_PREDICTION_URL=http://localhost:8002
AGENT_DECISION_URL=http://localhost:8003

# Origine autorisee pour CORS (le frontend en dev hybride tourne sur ce port Vite)
FRONTEND_ORIGIN=http://localhost:5173

# Secret de signature des JWT : OBLIGATOIRE et propre a chaque environnement en
# production (jamais la valeur d'exemple ci-dessous). Generer par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-in-every-environment
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
