# ============================================================================
# Variables d'environnement pour docker-compose.yml / docker-compose.prod.yml
# Copier ce fichier vers ".env" (jamais commite) puis ajuster les valeurs.
# ============================================================================

# --- Base de donnees MySQL --------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=smart_medicament

# --- Frontend / CORS ---------------------------------------------------------
# Origine exacte (schema+host+port) depuis laquelle le frontend est servi.
FRONTEND_ORIGIN=http://localhost:5173

# --- Authentification JWT (gateway) ------------------------------------------
# OBLIGATOIRE en production : secret long et aleatoire, propre a chaque
# environnement. Exemple de generation :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-in-every-environment
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# --- Logs --------------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development

# --- Sauvegardes MySQL (db/backup) -------------------------------------------
BACKUP_RETENTION_DAYS=7
